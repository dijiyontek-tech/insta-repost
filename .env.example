# Bu dosyayı .env olarak kopyala ve kendi değerlerinle doldur (sadece yerelde
# test etmek için — GitHub Actions'ta bunlar repo Secrets üzerinden gelir).

# Meta for Developers > App > Instagram Graph API'den alınır
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Supabase proje ayarları > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=insta-repost

# Opsiyonel
CAPTION_SUFFIX=
MAX_REPOSTS_PER_VIDEO=1
